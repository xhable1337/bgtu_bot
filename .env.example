# Настройки бота. Скопируйте этот файл в `.env` и заполните реальными значениями.
# Переменные окружения имеют приоритет над значениями из `.env`.

# Токен бота в Telegram
BOT_TOKEN=1234567890:ABCDEF1234-ghIklxxzyx57W2v1u123ew11

# URI для подключения к базе данных MongoDB
MONGODB_URI=mongodb://localhost:27017

# URL прокси-сервера (опционально). Оставьте пустым для прямого соединения.
PROXY_URL=socks5://username:password@host:port
